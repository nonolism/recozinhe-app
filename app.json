{
  "expo": {
    "name": "ReCozinhe",
    "slug": "recozinhe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F1E6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.recozinhe.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.recozinhe.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "O ReCozinhe usa a câmera para fotografar alimentos que seriam descartados."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O ReCozinhe acessa suas fotos para você escolher a imagem de um alimento."
        }
      ]
    ],
    "owner": "ruan_vitor_moreno",
    "extra": {
      "eas": {
        "projectId": "00f1d213-6727-4ca0-907e-4a666dbbde13"
      }
    }
  }
}