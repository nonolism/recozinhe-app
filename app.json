{
  "expo": {
    "name": "ReCozinhe",
    "slug": "recozinhe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F1E6",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        { "cameraPermission": "O ReCozinhe usa a câmera para fotografar alimentos que seriam descartados." }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "O ReCozinhe acessa suas fotos para você escolher a imagem de um alimento." }
      ]
    ]
  }
}
